# UniFi Protect NVR host (include http:// or https://)
UFP_HOST=https://192.168.1.10

# UniFi Protect API key.
# Generate one in the UniFi Protect web UI:
#   Settings → Control Plane → Integrations → Create API Key
# (Older firmware: Settings → Admins & Users → API Keys)
UFP_API_KEY=your_api_key_here

# Optional: skip SSL verification for self-signed NVR certs (default: true)
# UFP_VERIFY_SSL=false
